# =============================================================================
# PIP — copy to `.env` and fill in values (never commit `.env`)
# PIP — 复制为 `.env` 并填写（切勿提交 `.env`）
# =============================================================================

# --- Required for script + storyboard / 剧本 + 分镜（必需）---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- MVP language / MVP 语言（固定英文）---
PIP_DEFAULT_LANGUAGE=en

# --- TTS via fal (V2 default — same FAL_KEY as video/images) / 对白 ---
PIP_TTS_PROVIDER=fal
FAL_TTS_MODEL=fal-ai/elevenlabs/tts/eleven-v3
# Cheaper alternative: xai/tts/v1 with FAL_TTS_VOICE=rex|sal|eve|ara|leo
FAL_TTS_VOICE=21m00Tcm4TlvDq8ikWAM
FAL_TTS_LANGUAGE=en

# --- ElevenLabs direct (optional; only if PIP_TTS_PROVIDER=elevenlabs) ---
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- fal.ai (video + keyframe stills) / fal.ai 视频 + 静图 ---
# Get key: https://fal.ai/dashboard/keys
FAL_KEY=

# Kling first-last-frame (V2 only video path)
# Kling 首尾帧（V2 唯一视频路径）
FAL_VIDEO_MODEL_KLING_FL=fal-ai/kling-video/o1/standard/image-to-video

# Keyframe / preview / scene pack stills (Nano Banana Pro)
# 关键帧 / 预览 / 场景资产静图
FAL_IMAGE_MODEL=fal-ai/nano-banana-pro

# Tell fal NOT to use in-clip speech; PIP mixes VO separately
# 关闭镜头内对白；PIP 单独混 VO
FAL_VIDEO_GENERATE_AUDIO=false
FAL_VIDEO_RESOLUTION=1080p

# V2: no background music in final mix
# V2：成片不加 BGM
PIP_BGM_MODE=off

# Optional legacy BGM (only if you explicitly set PIP_BGM_MODE=fal|library)
# 可选旧 BGM（仅当 PIP_BGM_MODE=fal 或 library 时）
# FAL_BGM_MODEL=fal-ai/minimax-music/v2.6
# PIP_MUSIC_DIR=assets/music

# --- Gateway / 网关 ---
TELEGRAM_BOT_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Runtime / 运行配置 ---
APP_ENV=local
JOB_STORAGE_DIR=storage/jobs
TARGET_RESOLUTION=1920x1080
TARGET_FPS=30
MAX_GENERATION_RETRIES=2
MAX_JOB_COST_USD=10.0
MAX_STORYBOARD_REVISIONS=2
VIDEO_PIPELINE_MOCK=false
