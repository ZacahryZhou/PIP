# =============================================================================
# PIP — copy to `.env` and fill in values (never commit `.env`)
# PIP — 复制为 `.env` 并填写（切勿提交 `.env`）
# =============================================================================

# --- Required for script + storyboard / 剧本 + 分镜（必需）---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- MVP language / MVP 语言（固定英文）---
PIP_DEFAULT_LANGUAGE=en

# --- fal.ai (one key for video + TTS + BGM) / fal.ai 一把 Key 走视频+配音+配乐 ---
# Get key: https://fal.ai/dashboard/keys
FAL_KEY=

# Video — text-to-video endpoints (match routing: seedance + kling)
# 视频 — 文生视频 endpoint（对应路由 seedance + kling）
FAL_VIDEO_MODEL_SEEDANCE=fal-ai/bytedance/seedance/v1.5/pro/text-to-video
FAL_VIDEO_MODEL_KLING=fal-ai/kling-video/v3/pro/text-to-video
# Image-to-video endpoints (used when shot generation_mode=i2v)
# 图生视频 endpoint（当镜头 generation_mode=i2v 时使用）
FAL_VIDEO_MODEL_SEEDANCE_I2V=fal-ai/bytedance/seedance/v1.5/pro/image-to-video
FAL_VIDEO_MODEL_KLING_I2V=fal-ai/kling-video/v3/pro/image-to-video
# Keyframe still image (Nano Banana Pro)
# 关键帧静图（Nano Banana Pro）
FAL_IMAGE_MODEL=fal-ai/nano-banana-pro
# Default is v3/pro (native 1080p). For cheaper drafts use v3/standard (720p).
# 默认 v3/pro（原生 1080p）。便宜草稿可改 v3/standard（720p）。

# Optional fallback video model / 可选备用视频模型
FAL_VIDEO_MODEL_WAN=

# Tell fal NOT to use in-clip speech; PIP mixes VO + BGM separately
# 关闭镜头内对白；PIP 单独混 VO + BGM
FAL_VIDEO_GENERATE_AUDIO=false

# Dialogue TTS (English MVP) / 对白 TTS（MVP 英文）
FAL_TTS_MODEL=xai/tts/v1
FAL_TTS_VOICE=rex
FAL_TTS_LANGUAGE=en

# Background music mode: fal | library
# BGM 模式：fal 按文本生成 | library 本地 mp3 素材库
PIP_BGM_MODE=fal
FAL_BGM_MODEL=fal-ai/minimax-music/v2.6
# For instrumental BGM under dialogue, code sets is_instrumental=true
# 有对白时用纯器乐，代码会设 is_instrumental=true

# --- Local BGM library (only if PIP_BGM_MODE=library) / 本地配乐（仅 library 模式）---
# See assets/music/README.md and rules/MUSIC_LIBRARY.md
PIP_MUSIC_DIR=assets/music

# --- Direct provider keys (skip if using fal only) / 直连 Key（全走 fal 可不填）---
SEEDANCE_API_KEY=
KLING_API_KEY=
WAN_T2V_API_KEY=
ANTHROPIC_API_KEY=

# --- Gateway (Step 19) / 网关（步骤 19）---
TELEGRAM_BOT_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Runtime / 运行配置 ---
APP_ENV=local
JOB_STORAGE_DIR=storage/jobs
TARGET_RESOLUTION=1920x1080
TARGET_FPS=30
# Seedance API resolution: 480p | 720p | 1080p (Kling uses pro/standard endpoint tier)
FAL_VIDEO_RESOLUTION=1080p
MAX_GENERATION_RETRIES=2
MAX_JOB_COST_USD=5.0
VIDEO_PIPELINE_MOCK=false
